# Referência: configure no terminal ou na Run Configuration; não há loader de .env.
PROXY_MODE=http
PROXY_BIND_ADDRESS=127.0.0.1
PROXY_PORT=8080
PROXY_UPSTREAM_HOST=127.0.0.1
PROXY_UPSTREAM_PORT=8000
PROXY_TIMEOUT_MS=10000
PROXY_MAX_CONNECTIONS_PER_IP=5
# No modo TCP, defina também PROXY_USERNAME e PROXY_PASSWORD no ambiente.
